---
import BenchChart from './BenchChart.astro';
import { benchmarks, measuredDate, pending, projects, scenarios, versusBun } from '../data/bench.ts';
const base = import.meta.env.BASE_URL;
// The default view: the first repository, warm cache. Every other panel is prerendered
// beside it and shown by the controls below, so the page works without JavaScript too.
const first = 0;
const firstScenario = 1;
const toolNames = ['fnpm', 'Bun', 'pnpm', 'Yarn', 'npm'];
const measuredTools = (name: string) => [...new Set(projects.flatMap((p) => p.tools.filter((t) => t.name === name && t.version).map((t) => t.version)))].join(', ');
const unsupportedCount = projects.reduce((n, p) => n + p.tools.filter((t) => t.unsupported).length, 0);
---
<section class="register home-hero">
  <div class="home-container hero-grid">
    <div class="hero-copy">
      <a class="release-label label" href={`${base}project/releasing/`}><span>SOON</span> fnpm v0.0.3 <span aria-hidden="true">→</span></a>
      <h1 class="display">Less time<br /> installing.<br /><span class="accent">Less disk.</span><br />Fuck NPM.</h1>
      <p class="hero-description">A Rust-backed package manager for JavaScript. Native installs, a shared package store, and familiar Node.js projects. Bring your lockfile. Keep building.</p>
      <div class="install-label">Try fnpm</div>
      <div class="command-box cut"><span aria-hidden="true">$</span><code>npm install -g fnpm</code><button class="copy-install" aria-label="Copy install command">▢</button></div>
      <p class="install-note">Public npm publication pending. <a href={`${base}project/development/`}>Build from source ↗</a></p>
      <a class="quickstart-link" href={`${base}quickstart/`}>Then follow the quickstart <span aria-hidden="true">→</span></a>
    </div>
    <div class="hero-benchmark">
      <div class="project-tabs" role="group" aria-label="Benchmark repository">{projects.map((project, index) => <button data-project={index} aria-pressed={String(index === first)}>{project.short}</button>)}</div>
      <div class="benchmark-panel">
        {projects.map((project, p) => (
          <div class="hero-project" data-project-panel={p} hidden={p !== first}>
            <div class="benchmark-heading"><div><h2>Installing {project.name}</h2><p>{project.workspaces} workspaces · {project.originalPm} lockfile · <a href={`https://github.com/${project.repo}/tree/${project.commit}`}>{project.commit.slice(0, 7)} ↗</a></p></div><span class="label">LINUX X64</span></div>
            <div class="scenario-tabs" role="group" aria-label="Installation scenario">{scenarios.map((scenario) => <button data-scenario-select={scenario.key} aria-pressed={String(scenario.key === firstScenario)}>{scenario.label}</button>)}</div>
            {scenarios.map((scenario) => (
              <div class="hero-scenario" data-scenario-panel={scenario.key} hidden={scenario.key !== firstScenario}>
                <p class="scenario-caption">{scenario.label} · seconds, median of 3 runs</p>
                <BenchChart project={project} metric={scenario.key} />
                <div class="chart-legend"><span><i class="legend-highlight"></i>fnpm</span><span><i></i>Other package managers</span><span>Lower is better</span></div>
                <p class="benchmark-result">{versusBun(project, scenario.key) ?? 'Bun could not install this repository'}</p>
              </div>
            ))}
          </div>
        ))}
      </div>
      <p class="chart-method">Measured {measuredDate} · {toolNames.join(' · ')} · scripts disabled · warm OS and registry caches. A tool that cannot install a repository's format keeps its row.{pending.length > 0 && ` ${pending.length} more repositories are being measured.`} <a href={`${base}benchmarks/methodology/`}>Methodology ↗</a></p>
    </div>
  </div>
</section>
<section class="project-strip"><div class="home-container"><p class="label">MEASURED IN {projects.length} REAL REPOSITORIES</p><div>{projects.map(project => <a href={`https://github.com/${project.repo}`}>{project.short}<span> ↗</span></a>)}</div></div></section>
<section class="register home-section" id="benchmarks">
  <div class="home-container">
    <div class="section-intro"><div><p class="label">INSTALL BENCHMARKS</p><h2 class="display">The install you<br />actually run.</h2><p>Cold cache, warm cache, or a no-op reinstall. fnpm, Bun, pnpm, Yarn and npm on {projects.length} pinned repositories, each followed by a real project check.</p></div><a class="outline-button cut" href={`${base}benchmarks/real-projects/`}>Full results & methodology →</a></div>
    <div class="benchmark-toolbar"><label for="benchmark-project">Repository</label><select id="benchmark-project">{projects.map((project, index) => <option value={index} selected={index === first}>{project.name}</option>)}</select><span>Seconds · median of three runs · lower is better</span></div>
    {projects.map((project, p) => (
      <div class="scenario-grid" data-project-panel={p} hidden={p !== first}>
        {scenarios.map((scenario) => (
          <article class="scenario-card">
            <h3>{scenario.title}</h3><p>{scenario.description}</p>
            <BenchChart project={project} metric={scenario.key} compact />
            <p class="scenario-result">{versusBun(project, scenario.key) ?? 'Bun could not install this repository'}</p>
          </article>
        ))}
      </div>
    ))}
    <p class="section-footnote">Linux x64 / ext4 · {benchmarks.machine.cores} CPU cores · Node {benchmarks.machine.node.replace(/^v/, '')} · private package-manager caches · lifecycle scripts disabled · shared machine. Versions: Bun {measuredTools('bun')}; pnpm {measuredTools('pnpm')}; Yarn {measuredTools('yarn')}; npm {measuredTools('npm')}. “Fresh resolve” means the tool had no lockfile of its own in that repository, so its package versions can differ. {unsupportedCount > 0 && `${unsupportedCount} tool/repository pairs could not install and are marked.`} <a href={`${base}benchmarks/real-projects/`}>See ranges, package sets, and project checks ↗</a></p>
  </div>
</section>
<section class="home-section disk-section"><div class="home-container disk-grid">
  <div><p class="label">DISK USAGE</p><h2 class="display">Count the cache.<br />Not just the folder.</h2><p>Combined physical space for node_modules and each tool's private package cache or store, measured before any build. Shared hardlinks count once.</p><a class="quickstart-link" href={`${base}pm/store/`}>How the package store works →</a></div>
  <div class="disk-chart-wrap">
    {projects.map((project, p) => (
      <div data-project-panel={p} hidden={p !== first}>
        <p class="disk-caption">{project.name} · combined physical disk, lower is better</p>
        <BenchChart project={project} metric="disk" />
        <p class="benchmark-result">{versusBun(project, 'disk') ?? 'Bun could not install this repository'}</p>
      </div>
    ))}
    <p class="section-footnote">Shared reflink extents are not identified. Package sets differ where a tool resolved its own versions. <a href={`${base}benchmarks/real-projects/`}>Every repository ↗</a></p>
  </div>
</div></section>
<section class="register home-section"><div class="home-container"><p class="label">ONE PACKAGE. FOUR COMMANDS.</p><h2 class="display features-heading">Familiar projects.<br />A native install path.</h2><div class="feature-grid">
  <a href={`${base}pm/cli/install/`}><span class="feature-icon">◇</span><h3>fnpm</h3><p>Install, add, update, and manage dependencies. Native Rust launchers handle the hot paths.</p><code>fnpm install →</code></a>
  <a href={`${base}pm/lockfile/`}><span class="feature-icon">⌘</span><h3>fnpm-lock</h3><p>Bring npm, pnpm, Yarn, or Bun lockfiles. Inspect, migrate, verify, compare, and export.</p><code>fnpm-lock verify →</code></a>
  <a href={`${base}pm/fnpx/`}><span class="feature-icon">↗</span><h3>fnpx / fnpmx</h3><p>Run package executables with the same package store. Two aliases, one command.</p><code>fnpx cowsay hello →</code></a>
</div><p class="development-note">Built in the open. Full Bun package-manager parity and the all-scenario speed target are still in progress. <a href={`${base}status/`}>Compatibility status →</a></p></div></section>
<footer class="home-footer"><div class="home-container"><a class="fnpm-brand" href={base}>Fuck NPM</a><p>A package manager focused on install time and disk usage.</p><nav aria-label="Footer"><a href={`${base}docs/`}>Documentation</a><a href="https://github.com/SnowingFox/fuck-npm">GitHub ↗</a><a href={`${base}project/credits/`}>Credits & licenses</a></nav></div></footer>
<script>
  // The controls only choose which prerendered panel is visible.
  let project = 0;
  let scenario = 1;
  function show() {
    document.querySelectorAll<HTMLElement>('[data-project-panel]').forEach((el) => { el.hidden = Number(el.dataset.projectPanel) !== project; });
    document.querySelectorAll<HTMLElement>('[data-scenario-panel]').forEach((el) => { el.hidden = Number(el.dataset.scenarioPanel) !== scenario; });
    document.querySelectorAll<HTMLButtonElement>('[data-project]').forEach((el) => el.setAttribute('aria-pressed', String(Number(el.dataset.project) === project)));
    document.querySelectorAll<HTMLButtonElement>('[data-scenario-select]').forEach((el) => el.setAttribute('aria-pressed', String(Number(el.dataset.scenarioSelect) === scenario)));
    const select = document.querySelector<HTMLSelectElement>('#benchmark-project');
    if (select) select.value = String(project);
  }
  document.querySelectorAll<HTMLButtonElement>('[data-project]').forEach((button) => button.addEventListener('click', () => { project = Number(button.dataset.project); show(); }));
  document.querySelectorAll<HTMLButtonElement>('[data-scenario-select]').forEach((button) => button.addEventListener('click', () => { scenario = Number(button.dataset.scenarioSelect); show(); }));
  document.querySelector('#benchmark-project')?.addEventListener('change', (event) => { project = Number((event.target as HTMLSelectElement).value); show(); });
  document.querySelector('.copy-install')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    try { await navigator.clipboard.writeText('npm install -g fnpm'); button.textContent = '✓'; button.setAttribute('aria-label', 'Install command copied'); }
    catch { button.textContent = '!'; button.setAttribute('aria-label', 'Copy unavailable; select the command to copy'); }
  });
</script>
